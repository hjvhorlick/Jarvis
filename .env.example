# Copy to .env and fill in.  .env is git-ignored.
#   cp .env.example .env

# Your Google AI Studio key: https://aistudio.google.com/apikey
# New keys start with 'AQ.' (Auth keys); older ones start with 'AIza'. Both work.
GEMINI_API_KEY=

# Model to use.  Set to "mock" for offline/demo runs with no API calls.
JARVIS_MODEL=gemini-2.5-flash

# Optional: require this token on every POST (protects a public instance from
# spending or overwriting the key above). Sent as `Authorization: Bearer <token>`.
# JARVIS_AUTH_TOKEN=

# /docs and /openapi.json are hidden automatically when JARVIS_AUTH_TOKEN is set.
# JARVIS_EXPOSE_DOCS=1

# Optional overrides
# JARVIS_SYSTEM_PROMPT=You are Jarvis, a concise, capable assistant.
# JARVIS_MAX_TURNS=40
# JARVIS_HOST=0.0.0.0
# JARVIS_PORT=8000
